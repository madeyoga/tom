# Copy to .env (gitignored). These are local example values, not production secrets.

# Caddy site address.
#   localhost           HTTPS with Caddy's internal CA (this example's default)
#   app.example.com     public automatic HTTPS
# Production rejects an http confirm-email redirect, so do not use ":80".
PUBLIC_HOST=localhost

# Hostname only. AuthEndpoints passkeys ServerDomain. Never the container name.
# localhost for the internal-CA example. The public DNS name when TLS is public.
PASSKEYS_SERVER_DOMAIN=localhost

# Browser origin, no trailing slash. Confirm-email redirect and allowed origins.
# Must be https. https://localhost for the default. https://app.example.com in public.
PUBLIC_ORIGIN=https://localhost

# Postgres. Change the password before this host is reachable by anyone else.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tom_webapi
# Host port published for `dotnet ef` from your machine. Use 5433 if 5432 is taken.
POSTGRES_PORT=5432

# Production one-shot Admin. Leave blank until you want the first Admin created.
# The API reads these from the environment, not from its Development .env.
# POST /identity/register does not assign roles. Change the password after login.
SEED_BOOTSTRAP_ADMIN_EMAIL=
SEED_BOOTSTRAP_ADMIN_PASSWORD=

# Browser API base. Blank, ".", and "/" all mean same-origin relative URLs.
# Nuxt drops an empty env override and keeps http://localhost:5080, so this
# example uses "." .
NUXT_PUBLIC_API_BASE=.

# Server-side confirm-email fetch. The public base above is not an absolute URL.
NUXT_API_INTERNAL=http://webapi:8080
