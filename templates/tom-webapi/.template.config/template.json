{
  "$schema": "https://json.schemastore.org/template",
  "author": "madeyoga",
  "classifications": ["Web", "WebAPI"],
  "identity": "Tom.WebApi",
  "name": "Tom ASP.NET Core Web API",
  "description": "Opinionated ASP.NET Core 10 Web API: Npgsql, Identity with Guid keys, AuthEndpoints cookie facade, OpenAPI and Scalar.",
  "shortName": "tom-webapi",
  "sourceName": "Tom.WebApi",
  "preferNameDirectory": true,
  "defaultName": "Tom.WebApi",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            ".env"
          ]
        }
      ]
    }
  ]
}
