# Copy to .env (gitignored). Loaded only when ASPNETCORE_ENVIRONMENT=Development.

Seed__AdminEmail=admin@localhost
Seed__Password=

# Production (real environment variables or secrets, not this file).
# CORS stays off. ForwardedHeaders uses X-Forwarded-For and X-Forwarded-Proto.
# Passkeys ServerDomain and the confirm-email redirect are the public host,
# not a container name. See examples/same-origin/.env.example.
# Seed__BootstrapAdminEmail=
# Seed__BootstrapAdminPassword=
# AuthEndpoints__Passkeys__ServerDomain=app.example.com
# AuthEndpoints rejects an http confirm-email redirect in Production.
# AuthEndpoints__EmailConfirmation__ConfirmEmailRedirectUri=https://app.example.com/confirm-email
# AuthEndpoints__EmailConfirmation__AllowedRedirectOrigins__0=https://app.example.com
# ASPNETCORE_URLS=http://+:8080
