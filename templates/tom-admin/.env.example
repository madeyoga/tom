# Absolute API origin for local dual-port (Nuxt :3000, API :5080).
NUXT_PUBLIC_API_BASE=http://localhost:5080

# Same-origin behind Caddy: blank, ".", and "/" all become relative URLs.
# Nuxt ignores an empty env override and keeps the default above, so the
# compose example sets "." .
# NUXT_PUBLIC_API_BASE=.

# Server-only. Nitro confirm-email fetch. Leave unset for dual-port (the
# route then uses the absolute public base). Do not point this at a sentinel.
# NUXT_API_INTERNAL=http://webapi:8080
