<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>AuthEndpoints.Templates</PackageId>
    <Version>1.0.0</Version>
    <Authors>madeyoga</Authors>
    <Description>ASP.NET Core Web API template with AuthEndpoints cookie auth, EF Core + PostgreSQL, minimal APIs, OpenAPI + Scalar</Description>
    <PackageTags>dotnet-new;templates;authendpoints;aspnetcore;webapi</PackageTags>
    <PackageProjectUrl>https://github.com/madeyoga/tom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/madeyoga/tom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="tom-webapi/**" Exclude="tom-webapi/**/bin/**;tom-webapi/**/obj/**;tom-webapi/.env;tom-webapi/**/.env" />
    <Compile Remove="**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
